rules_version = '2';

// The browser never accesses Firestore directly: every read and write goes through the
// Express server, whose Admin SDK is not subject to these rules
// (workflow/specs/environments-and-deployment.md R3).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
